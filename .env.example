# Copy to `.env` and fill in values. Never commit `.env`.

# Photoshop bridge
DESAIN_BRIDGE_BACKEND=auto          # auto | uxp | com | mock
DESAIN_BRIDGE_HOST=127.0.0.1
DESAIN_BRIDGE_PORT=8765
DESAIN_BRIDGE_TIMEOUT_S=60
DESAIN_HISTORY_CHECKPOINT=true

# Paths
DESAIN_TEMPLATES_DIR=./templates
DESAIN_OUTPUT_DIR=./output
DESAIN_PLUGINS_DIR=./plugins

# Logging
DESAIN_LOG_LEVEL=INFO
DESAIN_LOG_JSON=false

# Optional cloud / local LLM settings (used by the desktop UI agent)
DESAIN_LLM_PROVIDER=openai_compatible
DESAIN_LLM_BASE_URL=http://localhost:1234/v1
DESAIN_LLM_API_KEY=
# Aliases also accepted:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# Unsplash (optional — image placement tools)
UNSPLASH_ACCESS_KEY=

# Enable raw JSX / batchPlay escape hatches
DESAIN_ALLOW_DESTRUCTIVE=false
