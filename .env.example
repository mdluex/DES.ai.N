# Copy to `.env` and fill in local values. Do not commit `.env`.

# Photoshop bridge used by the desktop app (and optional MCP server)
DESAIN_BRIDGE_BACKEND=auto          # auto | uxp | com | mock
DESAIN_BRIDGE_HOST=127.0.0.1
DESAIN_BRIDGE_PORT=8765
DESAIN_BRIDGE_TIMEOUT_S=60
DESAIN_HISTORY_CHECKPOINT=true

# Paths
DESAIN_TEMPLATES_DIR=./templates
DESAIN_OUTPUT_DIR=./output
DESAIN_PLUGINS_DIR=./plugins

# Logging
DESAIN_LOG_LEVEL=INFO
DESAIN_LOG_JSON=false

# Local LLM (default). DES.ai.N auto-detects LM Studio / Ollama / llama.cpp.
DESAIN_LLM_PROVIDER=local
DESAIN_LLM_BASE_URL=http://127.0.0.1:1234/v1
DESAIN_LLM_API_KEY=
DESAIN_LLM_AUTO_DETECT=true

# Optional cloud providers (never the default):
# DESAIN_LLM_PROVIDER=openai|groq|together|fireworks
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Unsplash (optional — image placement tools)
UNSPLASH_ACCESS_KEY=

# Enable raw JSX / batchPlay escape hatches
DESAIN_ALLOW_DESTRUCTIVE=false
