{
  "manifestVersion": 5,
  "id": "com.mdluex.desain.bridge",
  "name": "DES.ai.N Bridge",
  "version": "0.2.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.3.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "desain.bridge.panel",
      "label": {
        "default": "DES.ai.N Bridge"
      },
      "minimumSize": {
        "width": 280,
        "height": 220
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 280
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 320
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["ws://127.0.0.1", "ws://localhost"]
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  }
}
